{
  "rules": {
    ".read": false,
    ".write": false,
    "equipment_listing": {
      ".read": true,
      "$lineId": {
        ".write": "auth != null && (data.exists() ? data.child('owner_uid').val() === auth.uid : newData.child('owner_uid').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.child('owner_uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 300 && newData.child('topic_title').isString())"
      }
    },
    "equipment_listing_en": {
      ".read": true,
      "$lineId": {
        ".write": "auth != null && (data.exists() ? data.child('owner_uid').val() === auth.uid : newData.child('owner_uid').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.child('owner_uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 300 && newData.child('topic_title').isString())"
      }
    }
  }
}