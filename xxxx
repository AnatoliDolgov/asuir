                { name: 'Защитный наружный каркас корпуса и элементы внешнего оформления', qty: 1, price: 15.0 }
            ];
        }

        isUserOverridden = true; 
        document.getElementById('market-price-input').value = specPrice;
        document.getElementById('perf-val').innerText = setupPerf;
        document.getElementById('val-equip').value = setupEquipPrice;
        document.getElementById('status-equip').innerText = `Комплекс МКТУ: (${originalInput})`;
        
        const tbody = document.getElementById('component-dynamic-rows');
        tbody.innerHTML = ""; 
        dynamicComponents.forEach(comp => {
            renderStaticRow(comp.name, comp.qty, comp.price);
        });

        calculateAll();
    }

    function addComponentRow(name = "", qty = 1, price = 0) {
        renderStaticRow(name, qty, price);
        calculateAll();
    }

    function deleteComponentRow(rowId) {
        const row = document.getElementById(rowId);
        if (row) { row.remove(); calculateAll(); }
    }

    function updateDynamicOverhead() {
        calculateAll();
    }
    
    function calculateAll() {
        let totalEquipmentCost = 0;
        const rows = document.getElementById('component-dynamic-rows').children;
        for (let tr of rows) {
            let qty = parseFloat(tr.querySelector('.comp-qty').value) || 0;
            let prc = parseFloat(tr.querySelector('.comp-price').value) || 0;
            totalEquipmentCost += (qty * prc);
        }
        document.getElementById('total-bom-cost').innerText = totalEquipmentCost.toFixed(2);
        
        let equipAmortizationPerDay = totalEquipmentCost / 5 / 365;
        let rent = parseFloat(document.getElementById('val-rent').value) || 0;
        let staff = parseFloat(document.getElementById('val-staff').value) || 0;
        let singleSalary = parseFloat(document.getElementById('val-salary').value) || 0;
        let totalDailyConstantCosts = ((rent + (singleSalary * staff)) / 30);
        
        let finalDailyOverhead = Math.round(equipAmortizationPerDay + totalDailyConstantCosts);
        document.getElementById('base-overhead').innerText = finalDailyOverhead;

        let perf = parseInt(document.getElementById('perf-val').innerText) || 1;
        let machineShare = perf > 0 ? (finalDailyOverhead / perf) : 0;
        document.getElementById('machine-share-cost').innerText = machineShare.toFixed(3);
        
        let marketPrice = parseFloat(document.getElementById('market-price-input').value) || 0;
        document.getElementById('total-product-cost').innerText = machineShare.toFixed(2);
        
        let dayProfit = Math.round(perf * (marketPrice - machineShare));
        let monthProfit = Math.round(dayProfit * 30);
        document.getElementById('income-month').innerText = monthProfit > 0 ? monthProfit.toLocaleString('ru-RU') : 0;
    }

    function openScanner(rowId, inputId) { alert("Функция сканера"); }
    function openFeedbackModal(event) { if(event) event.preventDefault(); document.getElementById('feedback-modal').style.display = 'block'; }
    function closeFeedbackModal() { document.getElementById('feedback-modal').style.display = 'none'; }
    function handleFormSubmit(event) { event.preventDefault(); closeFeedbackModal(); }

    window.onload = function() { calculateAll(); };
</script>
